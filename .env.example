# ============================================================
# booking-analytics — пример окружения
#
#   cp .env.example .env
#
# .env в репозиторий не попадает (см. .gitignore). Здесь только
# локальные пароли для docker compose: наружу порты не публикуем.
# Меняя переменную в коде/Compose — сразу добавляйте её сюда.
# ============================================================

# Имя compose-проекта: от него зависят имена контейнеров и volumes,
# поэтому у Льва и Амира оно должно совпадать.
COMPOSE_PROJECT_NAME=booking-analytics

# Часовой пояс данных и контейнеров. Совпадает с DateTime('Asia/Vladivostok')
# в схеме, чтобы суточная сезонность читалась без пересчёта.
TZ=Asia/Vladivostok


# --- ClickHouse -------------------------------------------------
# Внутри сети compose сервисы ходят на clickhouse:8123 / clickhouse:9000,
# наружу публикуем только HTTP-порт для отладки и Superset с хоста.
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=change_me_clickhouse
CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1


# --- RabbitMQ (брокер событий) ----------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=booking
RABBITMQ_PASSWORD=change_me_rabbitmq
RABBITMQ_QUEUE=booking_events


# --- Postgres: метабаза Superset --------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=change_me_postgres


# --- Redis: кэш Superset ----------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379


# --- Superset ---------------------------------------------------
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change_me_superset_secret_key
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change_me_superset_admin
SUPERSET_ADMIN_EMAIL=admin@example.com
# Логин/пароль для входа в UI: admin / SUPERSET_ADMIN_PASSWORD


# --- Jupyter ----------------------------------------------------
JUPYTER_PORT=8888
# Пустой токен — только для локального запуска. В README укажите рабочий.
JUPYTER_TOKEN=change_me_jupyter_token


# --- Генератор событий ------------------------------------------
# interval — пауза между батчами, intensity — множитель интенсивности,
# seed — воспроизводимость «аномалий» при повторных запусках.
GENERATOR_INTERVAL_SEC=1.5
GENERATOR_INTENSITY=1.0
GENERATOR_SEED=42
GENERATOR_HISTORY_DAYS=30
GENERATOR_ANOMALY_RATE=0.01


# --- Потребитель RabbitMQ → ClickHouse ---------------------------
# Сколько событий копим перед вставкой и сколько ждём при недоборе.
CONSUMER_BATCH_SIZE=1000
CONSUMER_BATCH_TIMEOUT_SEC=2
CONSUMER_PREFETCH=2000


# --- Логирование ------------------------------------------------
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
